{
  "title": "NAM",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Neural Amp Modeler.",
        "",
        "Guitar amp and",
        "effect emulation",
        "using neural network",
        "models.",
        "",
        "Loads .nam model",
        "files and optional",
        ".wav cabinet IRs."
      ]
    },
    {
      "title": "Setup",
      "lines": [
        "Copy .nam model",
        "files into models/",
        "and .wav cabinet IRs",
        "into cabs/ using the",
        "Schwung manager at",
        "move.local:7700.",
        "",
        "Find amp models at:",
        "tone3000.com",
        "",
        "Subfolders are",
        "supported for",
        "organization."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Knob 1: Input",
        " Input level to amp",
        "",
        "Knob 2: Output",
        " Output level",
        "",
        "Cab Bypass:",
        " Skip cabinet IR",
        " (via menu)",
        "",
        "Choose Model and",
        "Choose Cabinet via",
        "the navigation menu."
      ]
    }
  ]
}
